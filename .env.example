# Copy this file to .env for local development.

# Local dev: run `docker compose up -d` (see docker-compose.yml) and use this URL.
# Production: set this in your host's env vars to a real Postgres connection
# string (Neon, Supabase, Vercel Postgres, etc.) — the same variable name.
DATABASE_URL="postgresql://psxemr:psxemr@localhost:5432/psxemr"
