# Copy this file to .env for local development.

# Local dev: run `docker compose up -d` (see docker-compose.yml) and use this URL.
# Prisma's MongoDB connector requires a replica set — even for a single local
# node — hence `replicaSet=rs0` below, matching docker-compose.yml.
DATABASE_URL="mongodb://localhost:27017/psxemr?replicaSet=rs0"

# Production: use your Atlas (or other hosted Mongo) connection string instead,
# e.g. "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/psxemr?retryWrites=true&w=majority"
