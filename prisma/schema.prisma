// Pharmacy EMR — data model per PRD Section 7
// MongoDB in all environments (see README for local setup / Atlas).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Pharmacy {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String?  @map("pharmacyName")
  subdomain   String   @unique @map("slug")
  logoUrl     String?
  brandColor  String   @default("#0F6E56")
  aiApiKey    String?
  createdAt   DateTime @default(now())

  branches Branch[]
  staff    Staff[]
  patients Patient[]

  @@map("pharmacies")
}

model Branch {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId String   @db.ObjectId
  name       String   @map("branchName")
  address    String?  @map("location")
  createdAt  DateTime @default(now())

  pharmacy  Pharmacy   @relation(fields: [pharmacyId], references: [id])
  staff     Staff[]
  patients  Patient[]
  encounters Encounter[]

  @@map("branches")
}

model Staff {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId String   @db.ObjectId
  branchId   String?  @db.ObjectId
  fullName   String   @map("name")
  phoneNumber String  @unique @map("phoneNumber")
  role       String   @default("pharmacist") // pharmacist, technician, admin, staff, etc
  passwordHash String?
  createdAt  DateTime @default(now())

  storeId             String?  @db.ObjectId
  failedLoginAttempts Int?     @default(0)
  lockedUntil         DateTime?

  pharmacy   Pharmacy    @relation(fields: [pharmacyId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  encounters Encounter[]
  auditLogs  AuditLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Patient
// ---------------------------------------------------------------------------

model Patient {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId  String   @db.ObjectId
  branchId    String?  @db.ObjectId
  fullName    String
  phoneNumber String
  dateOfBirth DateTime?
  gender      String? // male, female, other
  address     String?

  faceEmbedding String? // JSON-encoded float array, stubbed until face-api wired in
  photoUrl      String?

  knownAllergies    String @default("[]") // JSON array of { substance, severity, note }
  chronicConditions String @default("[]") // JSON array of strings
  currentMedications String @default("[]") // JSON array of { name, dose }

  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?

  createdAt   DateTime  @default(now())
  lastVisitAt DateTime?
  isWalkIn    Boolean   @default(false)

  pharmacy   Pharmacy    @relation(fields: [pharmacyId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  encounters Encounter[]

  @@index([pharmacyId, phoneNumber])
  @@index([pharmacyId, fullName])
  @@map("patients")
}

// ---------------------------------------------------------------------------
// Encounter and sub-records
// ---------------------------------------------------------------------------

// EncounterStatus: "active" | "complete" | "diagnostic_pending" | "diagnostic_resumed"
// ExitType: "treated" | "referred" | "diagnostic"
// (plain strings rather than a Prisma enum — values enforced in src/lib/enums.ts)

model Encounter {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId     String   @db.ObjectId
  pharmacyId    String   @db.ObjectId
  branchId      String?  @db.ObjectId
  staffId       String   @db.ObjectId
  encounterDate DateTime @default(now())
  status        String   @default("active")
  exitType      String?

  hpcAudioUrl        String?
  hpcVoiceTranscript String?

  patient Patient @relation(fields: [patientId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  complaint    Complaint?
  hpcs         Hpc[]
  historySnapshot PatientHistorySnapshot?
  ros          ReviewOfSystems?
  assessment   Assessment?
  managementPlan ManagementPlan?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addendums String @default("[]") // JSON array of { text, addedAt, staffName }

  @@index([pharmacyId, patientId])
  @@map("encounters")
}

model Complaint {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId     String   @unique @db.ObjectId
  voiceTranscript String?
  audioUrl        String?
  images          String   @default("[]") // JSON array of URLs
  files           String   @default("[]") // JSON array of URLs
  textInput       String?
  gemmaSummary    String?
  complaintSegments String @default("[]") // JSON array of { label, summary }
  createdAt       DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("complaints")
}

model Hpc {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId       String   @db.ObjectId
  complaintSegment  String
  questionsGenerated String  @default("[]") // JSON array of { question, options }
  answersGiven      String   @default("[]") // JSON array of { question, answer }
  freeTextAdditions String?
  createdAt         DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("hpcs")
}

model PatientHistorySnapshot {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId  String   @unique @db.ObjectId
  ageAtVisit   Int?
  gender       String?
  conditions   String   @default("[]")
  medications  String   @default("[]")
  allergies    String   @default("[]")

  socialHistory   String?
  familyHistory   String?
  surgicalHistory String?
  additionalNotes String?

  historyAudioUrl        String?
  historyVoiceTranscript String?
  aiRiskAnalysis         String?

  bloodPressure String?
  temperature   Float?
  bloodSugar    Float?
  pulse         Int?
  weight        Float?

  isPregnant     Boolean?
  isBreastfeeding Boolean?

  createdAt DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("patient_history_snapshots")
}

model ReviewOfSystems {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId        String   @unique @db.ObjectId
  questionsGenerated String   @default("[]") // JSON array of strings
  answersGiven       String   @default("[]") // JSON array of { question, answer: yes|no|unsure }
  createdAt          DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("review_of_systems")
}

model Assessment {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId         String   @unique @db.ObjectId
  pharmacistImpression String
  gemmaSuggestion     String?
  suggestionAccepted  Boolean?
  createdAt           DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("assessments")
}

model ManagementPlan {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  encounterId  String   @unique @db.ObjectId
  exitType     String

  // Exit A — diagnostics
  diagnosticsRecommended String  @default("[]") // JSON array of test names
  patientReturning       Boolean?
  interimTreatment       Boolean @default(false)

  // Exit B — referral
  referralDetails String? // JSON: { referredTo, reason, urgency }

  // Exit C / interim meds
  medicinesDispensed String? // JSON array of { name, dose, qty, interim }

  nonPharmacologicalAdvice String?
  followUpInstructions     String?
  counsellingNotes         String?

  linkedTransactionId String?
  dispensaryFulfilled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@map("management_plans")
}

// ---------------------------------------------------------------------------
// Audit log — every addition, update, or edit to any record.
// recordType/recordId are a polymorphic pointer (e.g. "patient" / patient.id);
// intentionally not a Prisma relation since it spans multiple record types.
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  recordType   String // e.g. "patient"
  recordId     String   @db.ObjectId
  fieldChanged String
  oldValue     String?
  newValue     String?
  changedById  String   @db.ObjectId
  changedAt    DateTime @default(now())

  changedBy Staff @relation(fields: [changedById], references: [id])

  @@index([recordType, recordId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// POS Inventory Integration
// ---------------------------------------------------------------------------

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  pharmacyId      String?  @db.ObjectId
  branchId        String?  @db.ObjectId
  slug            String?
  itemName        String
  brand           String?
  size            String?
  category        String?
  quantityInStock Float?
  retailPrice     Float?
  amount          Float?
  quantity        Float?
  source          String?
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("products")
}

model SsoToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sso_tokens")
}
